    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "codemirror": "^6.0.2",
    "js-yaml": "^5.4.2",
    "lit": "^3.3.3"
